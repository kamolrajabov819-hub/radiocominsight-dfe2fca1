# Copy to .env for local development, or set these in your host's
# environment-variable settings (Netlify: Site settings → Environment
# variables; Lovable: project settings → secrets).
#
# NEVER commit real keys. This repository is public — a committed API key
# is scraped and abused within minutes, and Google will disable it.

# --- Google Sheets -------------------------------------------------------
# Preferred. A plain Google API key with the Google Sheets API enabled.
# Works on any host, which is what makes a Netlify/Vercel deploy possible.
#
# An API key can only read a spreadsheet shared as
# "anyone with the link can view". Google refuses it for private files
# regardless of the key, so share the workbook that way first.
#
# Restrict the key in Google Cloud Console → Credentials:
#   API restrictions → Restrict key → Google Sheets API
GOOGLE_API_KEY=AIzaSyDGJ4IJvygFmEObgQezSPWACuJhGH7FU7s

# --- Google Sheets, via the Lovable connector ----------------------------
# Fallback, used only when GOOGLE_API_KEY is unset. Both are injected by
# Lovable at runtime and only work inside Lovable's own hosting.
LOVABLE_API_KEY=
GOOGLE_SHEETS_API_KEY=

# --- Supabase ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
